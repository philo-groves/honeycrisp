{
  "name": "honeycrisp",
  "version": "0.1.0",
  "description": "Command-line research agent.",
  "type": "module",
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "bin": {
    "honeycrisp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./websocket-protocol": {
      "types": "./dist/websocket-protocol.d.ts",
      "import": "./dist/websocket-protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@honeycrisp/research-agent": "workspace:*",
    "ws": "8.21.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  }
}
