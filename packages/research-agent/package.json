{
  "name": "@honeycrisp/research-agent",
  "version": "0.1.0",
  "description": "Research-agent layer built on Pi agent core and Pi AI.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace-tools": {
      "types": "./dist/workspace-tools.d.ts",
      "import": "./dist/workspace-tools.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./research-profile": {
      "types": "./dist/research-profile.d.ts",
      "import": "./dist/research-profile.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.228",
    "@anthropic-ai/sdk": "0.93.0",
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "tree-sitter-wasm": "1.1.1",
    "web-tree-sitter": "0.26.9",
    "zod": "4.4.3"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  }
}
