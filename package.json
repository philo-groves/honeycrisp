{
  "name": "honeycrisp-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous research agent workspace.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "start": "node packages/cli/dist/cli.js",
    "test": "tsc -b && HONEYCRISP_TEST_WORKSPACE_STORAGE=1 node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0"
}
